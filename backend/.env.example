# Copy this file to backend/.env. Never put real credentials in this example.

# Application
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value

# Database
DATABASE_URL=sqlite:///./data/assistant_reunion.db

# NVIDIA NIM (LLM)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT=300
NVIDIA_MAX_RETRIES=2
NVIDIA_MAX_TOKENS=16384
NVIDIA_TOP_P=0.95
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=16384

# Ollama (embeddings locaux uniquement)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=fr

# Storage
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=reunions
UPLOAD_FOLDER=./uploads
EXPORT_FOLDER=./exports
MAX_AUDIO_SEGMENT_BYTES=26214400

# HTTP / CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Workers and logs
WORKER_MAX_THREADS=4
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log

# SMTP (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PUBLIC_APP_URL=https://digireunionai.lynx-aiservice.online

# Paiements SaaS Mobile Money (utiliser d'abord une cle rsk_test_...)
RISERVA_BASE_URL=https://riserva.nalovan.cloud/api/v1
RISERVA_API_KEY=
RISERVA_WEBHOOK_SECRET=
RISERVA_MODE=SANDBOX
RISERVA_TIMEOUT=30
# URL HTTPS publique en production, ex. https://api.meetflow.cm/api/webhooks/riserva
PAYMENT_WEBHOOK_URL=
# Laisser false pendant la migration afin de ne bloquer aucun compte existant.
BILLING_ENFORCEMENT_ENABLED=true
FREE_TRIAL_MINUTES=10
